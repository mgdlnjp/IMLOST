{
  "expo": {
    "name": "IMLOST",
    "slug": "IMLOST",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1020"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "IMLOST utilise ta position pour l'envoyer par SMS à ton contact de confiance quand tu déclenches une alerte."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1020"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0B1020",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IMLOST utilise ta position pour l'envoyer par SMS à ton contact de confiance quand tu déclenches une alerte."
        }
      ]
    ]
  }
}
